 namespace td {
 
+namespace {
+// Read through the operating system rather than getenv: the C runtime copies the environment
+// when the process starts, so a value the app sets afterwards is only visible this way.
+std::string material_unigram_setting(const char *name) {
+#if TD_WINDOWS
+  char buffer[16384];
+  auto size = GetEnvironmentVariableA(name, buffer, static_cast<DWORD>(sizeof(buffer)));
+  if (size == 0 || size >= sizeof(buffer)) {
+    return std::string();
+  }
+  return std::string(buffer, size);
+#else
+  const char *value = std::getenv(name);
+  return value == nullptr ? std::string() : std::string(value);
+#endif
+}
+}  // namespace
