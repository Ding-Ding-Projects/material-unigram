+#if !TD_EMSCRIPTEN
+  // Material Unigram: a session marked as using a private server runs on the test path, and the
+  // app names that server here. Every data centre id points at it, because a self-hosted
+  // Telegram-compatible server answers for all of them at one address.
+  if (is_test) {
+    auto custom = material_unigram_setting("MATERIAL_UNIGRAM_SERVER");
+    if (!custom.empty()) {
+      Slice value(custom);
+      auto colon = value.rfind(':');
+      if (colon != static_cast<size_t>(-1)) {
+        auto host = value.substr(0, colon).str();
+        auto port = to_integer<int32>(value.substr(colon + 1));
+        if (!host.empty() && port > 0 && port < 65536) {
+          for (int32 dc_id = 1; dc_id <= 5; dc_id++) {
+            IPAddress ip_address;
+            if (ip_address.init_host_port(host, port).is_ok()) {
+              res.dc_options.emplace_back(DcId::internal(dc_id), ip_address);
+            }
+          }
+          if (!res.dc_options.empty()) {
+            return res;
+          }
+        }
+      }
+    }
+  }
+#endif
