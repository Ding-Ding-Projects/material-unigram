<controls:ModalPopup x:Class="Telegram.Views.Popups.PrivateServerPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="using:Telegram.Controls"
                     PrimaryButtonClick="OnPrimaryButtonClick"
                     mc:Ignorable="d">

    <StackPanel Spacing="16"
                MinWidth="400">
        <TextBlock x:Name="InfoLabel"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource InkTideMutedTextBrush}"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <TextBox x:Name="AddressField"
                 PlaceholderText="192.0.2.10:10443"
                 IsSpellCheckEnabled="False" />

        <TextBox x:Name="KeyField"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 Height="180"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsSpellCheckEnabled="False"
                 PlaceholderText="-----BEGIN RSA PUBLIC KEY-----" />

        <TextBlock x:Name="ErrorLabel"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Visibility="Collapsed" />

        <TextBlock x:Name="NoteLabel"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource InkTideMutedTextBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
</controls:ModalPopup>
