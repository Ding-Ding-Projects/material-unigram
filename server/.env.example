# Copy to server/.env (which git ignores) and fill in. The host assistant writes this for you.

# Required: password for the dashboard, 8 characters or more.
DASHBOARD_PASSWORD=

# Address put in the share link. Leave empty to use this computer's local network address.
# For use outside home, put your public address or domain and forward PROXY_PORT on your router.
PUBLIC_HOST=

# Port clients connect to. 443 looks like ordinary web traffic.
PROXY_PORT=443

# Port for the dashboard on this computer.
DASHBOARD_HOST_PORT=8080

# Optional: make the proxy look like HTTPS to this domain. Leave empty for random padding.
TLS_DOMAIN=

# Optional: promotion tag from @MTProxybot.
PROXY_TAG=
