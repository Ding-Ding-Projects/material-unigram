# Copy to server/full/.env (ignored by git). host.bat --full writes it for you with random
# passwords, so you only choose the dashboard password.

DASHBOARD_PASSWORD=
PUBLIC_HOST=
GATEWAY_PORT=10443
WEBSOCKET_PORT=11443
DASHBOARD_HOST_PORT=8081

# Internal services. Never published outside Docker; long random values are made for you.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
